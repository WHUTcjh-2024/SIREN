{
  "name": "siren-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src/views/TeacherDashboardView.vue src/data/teacherWorkspace.ts src/composables/useTeacherWorkspace.ts src/styles/teacher-workspace.css",
    "format:check": "prettier --check src/views/TeacherDashboardView.vue src/data/teacherWorkspace.ts src/composables/useTeacherWorkspace.ts src/styles/teacher-workspace.css",
    "check": "npm run format:check && vue-tsc -b && vitest run"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "prettier": "3.5.3",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.0"
  }
}
