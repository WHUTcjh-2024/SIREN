SIREN_ENV=development
SIREN_HOST=127.0.0.1
SIREN_PORT=8000
SIREN_CORS_ORIGINS=http://localhost:5173
SIREN_MAX_UPLOAD_BYTES=16777216
SIREN_MAX_IMAGE_PIXELS=40000000
SIREN_MAX_CONCURRENT_ANALYSES=1
SIREN_MAX_SAVED_ANALYSIS_RUNS=100
SIREN_MAX_AI_REQUESTS_PER_MINUTE=30
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
# Required in production. Generate a private value with: python -c "import secrets; print(secrets.token_urlsafe(24))"
TEACHER_ACCESS_CODE=
TEACHER_ID=local-teacher
TEACHER_NAME=本地试点教师
